// ==============================================================================
// CRM Comercial Empresarial - Esquema Relacional Base (Prisma ORM v6)
// Motor: PostgreSQL 16 | Zona horaria operativa: America/Guatemala
// ==============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Registro base de metadatos operativos del sistema (habilita generacion tipada
/// de PrismaClient en el arranque fundacional D1-1 antes de migrar entidades CRM).
model SystemMetadata {
  key       String   @id @db.VarChar(100)
  value     String   @db.Text
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("system_metadata")
}
