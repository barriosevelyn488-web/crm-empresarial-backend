# Variables de entorno y secretos (NUNCA versionar secretos reales)
.env
.env.*
!.env.example

# Dependencias de Node.js
node_modules/

# Artefactos de compilacion TypeScript
dist/
build/
*.tsbuildinfo

# Reportes de pruebas y cobertura
coverage/
.vitest/

# Registros de ejecucion y diagnostico
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

