# ==============================================================================
# CRM EMPRESARIAL BACKEND - PLANTILLA DE VARIABLES DE ENTORNO (.env.example)
# ==============================================================================
# Copie este archivo a `.env` para desarrollo local y reemplace todos los
# marcadores CHANGE_ME_* con secretos criptograficos generados con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NUNCA versione archivos `.env` con credenciales reales.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVIDOR HTTP Y RED
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
TZ=America/Guatemala

# Numero de saltos de proxy reverso confiables (Dokploy / Traefik / Cloudflare)
TRUST_PROXY_HOPS=1

# Origen principal del cliente web (SPA Frontend)
FRONTEND_ORIGIN=http://localhost:5173

# Lista separada por comas de origenes permitidos por CORS (credenciales activas)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ------------------------------------------------------------------------------
# 2. BASE DE DATOS RELACIONAL (PostgreSQL 16)
# ------------------------------------------------------------------------------
POSTGRES_USER=crm_user
POSTGRES_PASSWORD=crm_local_pass_2026
POSTGRES_DB=crm_empresarial_gt
POSTGRES_PORT=5432

# URL de conexion principal (pooler o directa en desarrollo local)
DATABASE_URL=postgresql://crm_user:crm_local_pass_2026@localhost:5432/crm_empresarial_gt?schema=public

# URL de conexion directa para migraciones Prisma CLI
DIRECT_URL=postgresql://crm_user:crm_local_pass_2026@localhost:5432/crm_empresarial_gt?schema=public

# ------------------------------------------------------------------------------
# 3. CACHE, COLAS ASINCRONAS (BullMQ) Y ADAPTADOR TIEMPO REAL (Redis 7)
# ------------------------------------------------------------------------------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# 4. SEGURIDAD, SESIONES Y TOKENS CRIPTOGRAFICOS (Minimo 32 caracteres)
# ------------------------------------------------------------------------------
JWT_ACCESS_SECRET=CHANGE_ME_REPLACE_WITH_64_HEX_CHARS_JWT_ACCESS_SECRET_000000
CSRF_SECRET=CHANGE_ME_REPLACE_WITH_64_HEX_CHARS_CSRF_DOUBLE_SUBMIT_000000
WS_TICKET_SECRET=CHANGE_ME_REPLACE_WITH_64_HEX_CHARS_WEBSOCKET_TICKET_0000000
INTEGRATION_API_KEY=CHANGE_ME_REPLACE_WITH_64_HEX_CHARS_SHEETS_BOT_INTEGRATION_KEY

# ------------------------------------------------------------------------------
# 5. PROVEEDOR DE MENSAJERIA WHATSAPP (sandbox | cloud)
# ------------------------------------------------------------------------------
# En produccion (NODE_ENV=production), WHATSAPP_PROVIDER=sandbox abortara el
# arranque a menos que ALLOW_SANDBOX_IN_PROD=true se defina explicitamente.
WHATSAPP_PROVIDER=sandbox
ALLOW_SANDBOX_IN_PROD=false

# Requeridos unicamente cuando WHATSAPP_PROVIDER=cloud
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
